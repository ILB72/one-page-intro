# 이 파일은 키 목록만 담는다. 실제 값은 backend/.env(로컬, Git 제외) 또는 Render 환경 변수에만 넣는다.

# Supabase (패스키 공개키·사용자·challenge 저장)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# WebAuthn 설정 (프론트가 열리는 도메인/출처)
RP_ID=
ORIGIN=

# 세션 서명용 비밀값 (긴 랜덤 문자열). 프로덕션에서 없으면 서버가 시작되지 않음
SESSION_SECRET=

# CORS 허용 출처 (쉼표 구분). 비우면 코드의 기본값 사용
ALLOWED_ORIGINS=

# 로그인 후에만 보이는 비공개 항목 (한 줄 JSON). 비우면 자리표시 문구 표시
# 형식: {"사용자이름":[{"title":"제목","content":"내용"}]}
PRIVATE_ITEMS_JSON=
